# Groq API key — https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"

# Business WhatsApp number for the "continue on WhatsApp" chat button (E.164 digits, no '+')
NEXT_PUBLIC_WHATSAPP_NUMBER="995557422942"

# Laravel CMS API base URL
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api/web"
NEXT_PUBLIC_BACKEND_URL="http://127.0.0.1:8000"

# Google Analytics 4 measurement ID (gtag.js)
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-TG66FPTB0Z"

# Meta (Facebook) Pixel ID — leave empty to disable
NEXT_PUBLIC_FB_PIXEL_ID=""
